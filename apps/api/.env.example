NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Managed PostgreSQL connection string (Aiven, Neon, Supabase, RDS, ...)
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_SSL=true
# Optional: PEM contents of the provider's CA certificate for full TLS verification
DATABASE_CA_CERT=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

COOKIE_DOMAIN=
COOKIE_SECURE=false
# Use `none` when the API and web client are on different domains in production
COOKIE_SAME_SITE=lax

WEB_ORIGIN=http://localhost:3000

# Leave MISTRAL_API_KEY empty to run the assistant in deterministic fallback mode
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

BUSINESS_TIMEZONE=UTC
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=18

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_CHAT_MAX_REQUESTS=20
