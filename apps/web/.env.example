# Where the API lives. Used by the Next.js rewrite that proxies /api/v1/*, so
# the browser only ever talks to this app's own origin and the session cookie
# stays first-party. Read at build time: changing it needs a redeploy.
API_ORIGIN=http://localhost:4000

# Socket.IO endpoint. Not proxied — WebSockets cannot pass through the rewrite —
# so this addresses the API host directly. Realtime updates are an enhancement;
# every screen works without them.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Optional. Set only to bypass the proxy and call the API host directly; leave
# unset in any deployment where the client and API are on different domains.
# NEXT_PUBLIC_API_URL=
