# ---------------------------------------------------------------------------
# Example environment file — placeholders only, safe to commit.
#
# Copy the blocks below into apps/api/.env and apps/web/.env.local and fill in
# real values there. Those files are git-ignored.
# ---------------------------------------------------------------------------

# --- apps/api/.env ---------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Managed PostgreSQL connection string (Aiven, Neon, Supabase, RDS, ...)
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_SSL=true
# Optional: PEM contents of the provider's CA certificate for full TLS verification
DATABASE_CA_CERT=

# Auth. Generate strong values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

COOKIE_DOMAIN=
COOKIE_SECURE=false
# Use `none` when the API and web client are on different domains in production
COOKIE_SAME_SITE=lax

# Browser origin allowed by CORS (comma separated for multiple)
WEB_ORIGIN=http://localhost:3000

# AI provider (https://console.mistral.ai - free tier available).
# Leave empty to run the assistant in deterministic fallback mode.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# Business hours used to validate booking slots (24h clock, business timezone)
BUSINESS_TIMEZONE=UTC
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=18

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_CHAT_MAX_REQUESTS=20

# --- apps/web/.env.local ---------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
